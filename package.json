{
  "name": "block-ai-content",
  "version": "0.3.0",
  "private": true,
  "description": "Chrome extension that hides AI-labelled images: C2PA/IPTC metadata everywhere, and Meta's \"AI info\" labels on Facebook, Instagram and Threads.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radiosilence/block-ai-content.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "lint": "oxlint && oxfmt --check",
    "format": "oxlint --fix && oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "aube run lint && aube run typecheck && aube run test && aube run build && aube run e2e",
    "package": "node scripts/build.mjs && node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
