{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "chrome": "readonly"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "ignorePatterns": ["dist/**", "test-results/**", "playwright-report/**"],
  "rules": {
    "no-await-in-loop": "off"
  },
  "overrides": []
}
